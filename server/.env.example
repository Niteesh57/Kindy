# Server Configuration
PORT=3001

# Google Vertex AI / Gemini API Credentials
# Provide your Gemini / Vertex AI API key below:
GEMINI_API_KEY=
# Optional Google Cloud Project & Location (if using Vertex AI directly)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model Identifiers
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Default Voice for Gemini TTS (Options: Kore, Puck, Fenrir, Aoede, Leda, Zephyr, Orus, Charon)
GEMINI_TTS_VOICE=Kore
